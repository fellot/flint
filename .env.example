# Required for the app (Supabase project -> Connect / API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy anon keys are also supported through NEXT_PUBLIC_SUPABASE_ANON_KEY.

# Used for password recovery links. Set to the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required to invite new accounts from the owner’s People dialog.
# Also used by the optional --apply importer. Server-only: never use NEXT_PUBLIC_ here.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy SUPABASE_SERVICE_ROLE_KEY is also supported.

# Existing AI features (optional)
OPENAI_API_KEY=
